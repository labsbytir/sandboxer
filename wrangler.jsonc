{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandboxer-controller",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-17",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandboxer",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/worker/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "sandboxer-reports" }],
  "vars": {
    "ACCOUNT_ID": "",
    "BASIN_BUCKET": "sandboxer-telemetry",
    "BASIN_TABLE": "default.telemetry",
    "PIPELINE_URL": "",
  },
}
